{#
	luci-theme-FluentDesign

	Closes every container opened in header.ut, in reverse order:
	  .container  ->  #maincontent  ->  (footer)  ->  .main-right  ->  .main
-#}

				</div>
			</div>
			<footer class="mobile-hide">
				<div class="footer-content">
					<a class="luci-link" href="https://github.com/openwrt/luci" target="_blank" rel="noopener">Powered by {{ version.luciname }} ({{ version.luciversion }})</a>
					<span class="footer-separator">|</span>
					<a href="https://github.com/openwrt/luci" target="_blank" rel="noopener">FluentDesign Theme</a>
					<span class="footer-separator">|</span>
					<a class="luci-link" href="{{ version.disturl }}" target="_blank" rel="noopener">{{ version.distname }} {{ version.distversion }}-{{ version.distrevision }}</a>

					<ul class="breadcrumb" id="modemenu" style="display:none"></ul>
				</div>
			</footer>
		</div>
	</div>
	<script>
		// thanks for Jo-Philipp Wich <jow@openwrt.org>
		var luciLocation = {{ ctx.path }};
	</script>
	<script type="text/javascript">L.require('menu-fluentdesign')</script>
</body>
</html>
