{#
	luci-theme-FluentDesign
	A Microsoft Fluent Design language theme for LuCI.

	Licensed to the public under the Apache License 2.0.

	Structure contract: every container opened here is closed in footer.ut.
	LuCI injects the rendered view into #maincontent > .container, so the
	open/close pairing must stay symmetric or views land in the wrong node.
-#}

{%
	import { access } from 'fs';
	import { getuid, getspnam } from 'luci.core';
	import { cursor } from 'uci';

	const boardinfo = ubus.call("system", "board");
	const hostname = striptags(boardinfo?.hostname ?? '?');

	let cfg = cursor();

	http.prepare_content('text/html; charset=UTF-8');

	// Validate user-supplied personalization before injecting it as CSS.
	function validColor(value, fallback) {
		return type(value) == 'string' && match(value, /^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$/) ? value : fallback;
	}

	function validNumber(value, fallback, min, max) {
		return type(value) == 'string' &&
			match(value, /^(0|[1-9][0-9]*)(\.[0-9]+)?$/) &&
			+value >= min && +value <= max ? value : fallback;
	}

	let mode = 'normal';
	let primary = '#0078d4';
	let dark_primary = '#2899f5';
	let font_scale = '1';
	let blur_radius = '30';
	let acrylic_opacity = '0.7';

	if (access('/etc/config/fluentdesign')) {
		primary = validColor(cfg.get_first('fluentdesign', 'global', 'primary'), primary);
		dark_primary = validColor(cfg.get_first('fluentdesign', 'global', 'dark_primary'), dark_primary);
		font_scale = validNumber(cfg.get_first('fluentdesign', 'global', 'font_size'), font_scale, 0.8, 1.3);
		blur_radius = validNumber(cfg.get_first('fluentdesign', 'global', 'blur'), blur_radius, 0, 100);
		acrylic_opacity = validNumber(cfg.get_first('fluentdesign', 'global', 'acrylic_opacity'), acrylic_opacity, 0, 1);
		let configured_mode = cfg.get_first('fluentdesign', 'global', 'mode');
		if (configured_mode == 'normal' || configured_mode == 'dark' || configured_mode == 'light')
			mode = configured_mode;
	}

	const bar_color = mode == 'dark' ? dark_primary : primary;
	const has_config = access('/etc/config/fluentdesign');
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">

<head>
	{% include("themes/" + theme + "/head_meta", { hostname: hostname, node: node, bar_color: bar_color, media: media }) %}

	<link rel="stylesheet" href="{{ media }}/css/cascade.css">
	{% if (mode == 'normal'): %}
	<link rel="stylesheet" href="{{ media }}/css/dark.css" media="(prefers-color-scheme: dark)">
	{% elif (mode == 'dark'): %}
	<link rel="stylesheet" href="{{ media }}/css/dark.css">
	{% endif %}
	{% if (has_config): %}
	<style>
		:root {
			--primary: {{ primary }};
			--font-scale: {{ font_scale }};
			--acrylic-blur: {{ blur_radius }}px;
			--acrylic-opacity: {{ acrylic_opacity }};
		}
		{% if (mode == 'normal'): %}
		@media (prefers-color-scheme: dark) {
			:root { --primary: {{ dark_primary }}; }
		}
		{% elif (mode == 'dark'): %}
		:root { --primary: {{ dark_primary }}; }
		{% endif %}
	</style>
	{% endif %}
	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
	{% endif %}
	{% if (css): %}
	<style>
		{{ css }}
	</style>
	{% endif %}
	<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}?v={{ version.luciversion }}"></script>
	<script src="{{ resource }}/cbi.js?v={{ version.luciversion }}"></script>
	<script src="{{ resource }}/luci.js?v={{ version.luciversion }}"></script>
</head>

<body
	class="lang_{{ dispatcher.lang }}{% if (ctx.authsession): %} logged-in{% endif %}"
	data-page="{{ entityencode(join('-', ctx.request_path), true) }}">

	<div class="main">
		<div class="main-left" id="mainmenu" style="display:none">
			<div class="sidenav-header">
				<a class="brand" href="/">
					<img src="{{ media }}/img/logo.svg" class="brand-logo" alt="">
					<span class="brand-text">{{ hostname }}</span>
				</a>
			</div>
		</div>
		<div class="main-right">
			<header class="app-header">
				<div class="fill">
					<div class="container">
						<div class="flex1">
							<button type="button" class="showSide" aria-label="{{ entityencode(_('Toggle navigation'), true) }}" aria-controls="mainmenu" aria-expanded="false">
								<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
									<path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
								</svg>
							</button>
							<a class="brand" href="/">{{ hostname }}</a>
						</div>
						<div class="status" id="indicators"></div>
					</div>
				</div>
			</header>
			<div class="darkMask"></div>
			<div id="maincontent">
				<div class="container">
					{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
					<div class="alert-message error fluent-alert">
						<h4>{{ _('No password set!') }}</h4>
						<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
						{% if (dispatcher.lookup("admin/system/admin")): %}
						<div class="right"><a class="btn cbi-button cbi-button-action" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
						{% endif %}
					</div>
					{% endif %}

					<noscript>
						<div class="alert-message error fluent-alert">
							<h4>{{ _('JavaScript required!') }}</h4>
							<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
						</div>
					</noscript>

					<div id="tabmenu" style="display:none"></div>
