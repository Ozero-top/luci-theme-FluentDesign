<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ hostname }}{{ node?.title ? ` - ${striptags(node.title)}` : '' }} - LuCI</title>

<!-- Security -->
<meta name="robots" content="noindex, nofollow">
<meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin">

<!-- Mobile / PWA -->
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="{{ hostname }} - LuCI">

<!-- Fluent Design theme color -->
<meta name="theme-color" content="{{ bar_color }}">

<!-- Icons (SVG-only, shipped with the theme) -->
<link rel="icon" type="image/svg+xml" href="{{ media }}/icon/favicon.svg">
<link rel="apple-touch-icon" href="{{ media }}/icon/apple-touch.svg">
<link rel="manifest" href="{{ media }}/icon/manifest.json">
